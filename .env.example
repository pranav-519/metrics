# Legal Metrology Compliance Scanner Configuration

# Backend Settings
PROJECT_NAME="Legal Metrology Packaged Commodities Compliance Scanner"
PROJECT_SLUG="metricheck"
VERSION="1.0.0"

# Database connection:
# Default SQLite (zero setup for hackathon):
DATABASE_URL=sqlite:///./legal_metrology.db
# Or PostgreSQL for production / Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metricheck_db

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# Rules Versioning
DEFAULT_LEGAL_FRAMEWORK="Legal Metrology (Packaged Commodities) Rules, 2011"
DEFAULT_RULE_VERSION="2024.1"

# OCR Configuration
OCR_ENGINE=rapidocr
OCR_CONFIDENCE_THRESHOLD=0.50
OCR_ENABLE_FALLBACK=false
OCR_MAX_ATTEMPTS=2
# Optional Cloud Fallback (Keep blank for local offline execution with RapidOCR)
GEMINI_API_KEY=
